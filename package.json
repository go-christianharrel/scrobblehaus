{
	"name": "scrobblehaus",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"format": "prettier --write src",
		"format:check": "prettier --check src"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/assets/*": "./src/lib/assets/*",
		"#lib/exporter.svelte": "./src/lib/exporter.svelte.ts",
		"#lib/recentFeed.svelte": "./src/lib/recentFeed.svelte.ts",
		"#lib/settings.svelte": "./src/lib/settings.svelte.ts",
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*": "./src/lib/*.ts"
	},
	"license": "MIT"
}
